# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source and configuration files
*.swift text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.xcprivacy text eol=lf
*.entitlements text eol=lf

# Binary assets
*.png binary
*.icns binary
*.jpg binary
*.jpeg binary
